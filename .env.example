# =================================================================
# KWANGTAE QUANT TERMINAL & AI BROKER - CONFIGURATION
# =================================================================
# Copy file này thành .env và điền các giá trị thực tế của bạn.
# TUYỆT ĐỐI KHÔNG commit file .env chứa giá trị thật lên GitHub!

# 1. Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_KEY=AIzaSyYourGeminiApiKeyHere

# 2. Telegram Bot Token (Tạo bot qua @BotFather trên Telegram: https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 3. Telegram Chat ID nhận báo cáo (Lấy Chat ID cá nhân qua @userinfobot trên Telegram)
TELEGRAM_CHAT_ID=123456789

# 4. Danh sách Chat ID được phép truy cập danh mục nhạy cảm (phân tách bằng dấu phẩy)
# Nếu để trống, bot chỉ hỗ trợ phân tích kỹ thuật chung, không tiết lộ tài sản cá nhân
ALLOWED_CHAT_IDS=123456789

# 5. Khóa bảo mật nội bộ để bảo vệ các endpoint POST /api/config và cảnh báo lệnh
API_SECRET=your_random_secure_secret_token_here

# 6. (Tùy chọn) Vercel KV / Upstash Redis nếu muốn lưu trữ danh mục trên đám mây
KV_REST_API_URL=
KV_REST_API_TOKEN=
